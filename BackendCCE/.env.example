# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database Configuration
# Para desarrollo local, usamos SQLite (no necesita DATABASE_URL)
# El archivo se creará automáticamente como database.sqlite
# Para producción con PostgreSQL, configura DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Configuration
# IMPORTANT: Generate a secure secret for production
# Generate with: openssl rand -base64 64
# NEVER use the dev secret in production!
JWT_SECRET=CHANGE_THIS_TO_SECURE_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=24h

# Email Configuration (Optional - no requerido para testing)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Club Comandante Espora <noreply@clubespora.com>

# MercadoPago Configuration (Optional - no requerido para testing)
# Get your credentials from: https://www.mercadopago.com/developers
MP_ACCESS_TOKEN=your_mercadopago_access_token
MP_PUBLIC_KEY=your_mercadopago_public_key
MP_WEBHOOK_SECRET=your_webhook_secret
MP_SUCCESS_URL=http://localhost:3000/pago-exitoso
MP_FAILURE_URL=http://localhost:3000/pago-fallido
MP_PENDING_URL=http://localhost:3000/pago-pendiente

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Test User Credentials (DEVELOPMENT ONLY)
# IMPORTANT: Password requirements: min 12 chars, uppercase, lowercase, number, special char
# These are used when running npm run test-env or npm run init-db
# Default passwords if not set: AdminCCE2024!@ and StaffCCE2024!@
ADMIN_PASSWORD=AdminCCE2024!@
STAFF_PASSWORD=StaffCCE2024!@
ADMIN_EMAIL=admin@cce.com
STAFF_EMAIL=staff@cce.com
